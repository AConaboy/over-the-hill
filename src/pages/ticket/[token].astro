---
import Layout from "../../layouts/Layout.astro";
import LinkProblemNotice from "../../components/LinkProblemNotice.astro";
import TicketQr from "../../components/TicketQr.astro";
import PaymentPanel from "../../components/PaymentPanel.astro";
import { getGuestByToken } from "../../lib/guests";
import { getPaymentSettings } from "../../lib/settings";
import { isStripeConfigured } from "../../lib/stripe";
import { REMEMBER_COOKIE_NAME, REMEMBER_COOKIE_OPTIONS } from "../../lib/rememberCookie";

const { token } = Astro.params;
const guest = token ? await getGuestByToken(token) : null;

// Once a guest has responded, their ticket link never expires — they still
// need it to view/update their answers and, later, pay. So unlike
// /rsvp/[token], there's no expiry check here.

if (guest) {
  Astro.cookies.set(REMEMBER_COOKIE_NAME, guest.token, REMEMBER_COOKIE_OPTIONS);
}

const settings = await getPaymentSettings();
const cancelled = guest?.status === "cancelled";
// Back from Stripe. The webhook, not this redirect, records the payment, so
// it may take a moment to show.
const justPaid = Astro.url.searchParams.get("paid") === "1";
const payError = Astro.url.searchParams.get("payerror") === "1";
---

<Layout title="Your ticket | Over the Hill" description="View your Over the Hill ticket and RSVP status.">
  <main>
    {!guest && <LinkProblemNotice kind="not_found" />}

    {guest && (
      <>
        <section class="page-hero">
          <div class="page-hero-content">
            <p class="eyebrow">Your ticket</p>
            <h1>{guest.name}</h1>
            <p class="page-introduction">
              Everything you need to know about your ticket, and what's next.
            </p>
          </div>
        </section>

        <section class="page-content">
          {cancelled && (
            <article class="content-block notice">
              <h2>Your place has been cancelled</h2>
              <p>If you think this is a mistake, please contact one of the hosts.</p>
            </article>
          )}

          {!cancelled && justPaid && guest.payment_status !== "paid_full" && (
            <article class="content-block notice">
              <h2>Thanks for your payment!</h2>
              <p>It's being confirmed. Refresh this page in a moment if it isn't showing yet.</p>
            </article>
          )}

          {!cancelled && payError && (
            <article class="content-block notice">
              <h2>We couldn't start the payment</h2>
              <p>Nothing has been charged. Please try again, or contact a host if it keeps happening.</p>
            </article>
          )}

          {!cancelled && guest.attendance === "pending" && (
            <article class="content-block notice">
              <h2>You haven't RSVP'd yet</h2>
              <p>
                We don't have your answers yet. Head over to your
                <a href={`/rsvp/${guest.token}`}>RSVP form</a> to let us know
                if you're coming.
              </p>
            </article>
          )}

          {!cancelled && guest.attendance === "no" && (
            <article class="content-block notice">
              <h2>You're marked as not attending</h2>
              <p>
                Sorry to miss you! If your plans change, you can update your
                answer any time on your <a href={`/rsvp/${guest.token}`}>RSVP form</a>.
              </p>
            </article>
          )}

          {!cancelled && guest.attendance === "yes" && (
            <>
              <article class="content-block">
                <h2>You're on the list 🎉</h2>
                <p>
                  Show this at the gate if asked — it's your confirmation
                  that you're coming to Over the Hill.
                </p>

                {guest.ticket_ref && <TicketQr ticketRef={guest.ticket_ref} />}
                {guest.payment_status === "paid_full" && <p class="paid-badge">Paid in full</p>}
              </article>

              <article class="content-block">
                <h2>Your details</h2>
                <ul class="information-list">
                  {guest.arrival_day && <li>Arriving: {guest.arrival_day}</li>}
                  {guest.departure_day && <li>Departing: {guest.departure_day}</li>}
                  {guest.camping && <li>Camping: {guest.camping.replace("_", " ")}</li>}
                  {guest.vehicle && <li>Vehicle: {guest.vehicle.replace("_", " ")}</li>}
                  {guest.dietary && <li>Dietary requirements: {guest.dietary}</li>}
                  {guest.accessibility && <li>Accessibility requirements: {guest.accessibility}</li>}
                </ul>
                <p>
                  <a class="text-link" href={`/rsvp/${guest.token}`}>
                    Need to change something? Update your RSVP →
                  </a>
                </p>
              </article>

              <PaymentPanel guest={guest} settings={settings} stripeConfigured={isStripeConfigured()} />
            </>
          )}

          <div class="page-actions">
            <a class="button" href="/">Return home</a>
          </div>
        </section>
      </>
    )}
  </main>
</Layout>
