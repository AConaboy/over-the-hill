---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Your ticket | Over the Hill" description="View your Over the Hill ticket using your personal link.">
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <p class="eyebrow">Tickets</p>
        <h1>Your ticket</h1>
        <p class="page-introduction">
          Tickets are personal — find yours via the link in your RSVP
          confirmation email, or ask a host to resend it.
        </p>
      </div>
    </section>

    <section class="page-content">
      <div class="page-actions">
        <a class="text-link" href="/rsvp">← RSVP</a>
        <a class="button" href="/">Return home</a>
      </div>
    </section>
  </main>
</Layout>
