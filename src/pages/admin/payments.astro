---
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { lastPaymentDueEmailAt, listGuestsForPayments, listGuestsWithInviters, logPaymentDueEmails } from "../../lib/guests";
import { getPaymentSettings, getTicketSettings, paymentSettingsProblem, savePaymentSettings, saveTicketSettings } from "../../lib/settings";
import { nextPayment, overpaidBy, ticketPrice } from "../../lib/payments";
import { sendPaymentDueEmails } from "../../lib/email";
import { isStripeConfigured } from "../../lib/stripe";
import { checkboxField, penceField } from "../../lib/forms";
import { formatPence } from "../../lib/money";

// Handles its own form: on a problem, the page re-renders with the host's
// input kept and the reason shown; on success it redirects (so a refresh
// doesn't resubmit).
const stripeConfigured = isStripeConfigured();
let error: string | null = null;
let settings = await getPaymentSettings();

let form: FormData | null = null;
if (Astro.request.method === "POST") form = await Astro.request.formData();

// The small Tickets form further down posts here too.
if (form && form.get("form") === "tickets") {
  await saveTicketSettings({ qrCodes: checkboxField(form, "qrCodes") });
  return Astro.redirect("/admin/payments?saved=tickets#tickets", 303);
}
const ticketSettings = await getTicketSettings();

// Everyone coming who can pay something right now, as their page would
// offer it (nextPayment), for the "payment due" emails.
async function guestsWithPaymentDue() {
  const current = await getPaymentSettings();
  return (await listGuestsWithInviters({ kind: "attending" }))
    .map((guest) => ({ guest, due: nextPayment(guest, current, stripeConfigured) }))
    .filter((row): row is { guest: typeof row.guest; due: Exclude<typeof row.due, { kind: "none" }> } => row.due.kind !== "none");
}

// "Email everyone who has something to pay", once a host has confirmed.
let emailError: string | null = null;
if (form && form.get("form") === "notify") {
  const recipients = (await guestsWithPaymentDue()).filter(({ guest }) => guest.email);
  try {
    const sent = await sendPaymentDueEmails(recipients);
    await logPaymentDueEmails(
      recipients.slice(0, sent).map(({ guest, due }) => ({
        guestId: guest.id,
        detail: `Emailed: ${due.kind === "deposit" ? "deposit" : (guest.amount_paid_pence ?? 0) > 0 ? "balance" : "ticket"} due (${formatPence(due.amountPence)})`,
      })),
      Astro.locals.hostEmail ?? "a host",
    );
    return Astro.redirect(`/admin/payments?emailed=${sent}#notify`, 303);
  } catch (err) {
    console.error("Failed to send payment due emails", err);
    emailError = err instanceof Error ? err.message : "The emails couldn't be sent.";
  }
}

if (form && form.get("form") !== "notify") {
  const depositPence = penceField(form, "deposit");
  const standardPricePence = penceField(form, "standardPrice");
  const submitted = {
    depositPence: depositPence === "invalid" ? null : depositPence,
    standardPricePence: standardPricePence === "invalid" ? null : standardPricePence,
    depositsOpen: checkboxField(form, "depositsOpen"),
    balanceOpen: checkboxField(form, "balanceOpen"),
  };
  error =
    depositPence === "invalid" || standardPricePence === "invalid"
      ? "Amounts must be in pounds, like 20 or 12.50."
      : paymentSettingsProblem(submitted, stripeConfigured);
  if (!error) {
    await savePaymentSettings(submitted);
    return Astro.redirect("/admin/payments?saved=1", 303);
  }
  settings = submitted;
}

const saved = Astro.url.searchParams.get("saved");
const amountValue = (pence: number | null) => (pence === null ? "" : formatPence(pence, { symbol: false }));

// Totals over guests who are attending and not cancelled.
const guests = await listGuestsForPayments();
const attending = guests.filter((g) => g.attendance === "yes" && g.status !== "cancelled");
const received = guests.reduce((sum, g) => sum + (g.amount_paid_pence ?? 0), 0);
let toCollect = 0;
let unpriced = 0;
for (const g of attending) {
  const price = ticketPrice(g, settings);
  if (price === null) unpriced++;
  else toCollect += Math.max(0, price - (g.amount_paid_pence ?? 0));
}
const awaitingPayment = attending.filter((g) => !g.registered_at).length;
const dueNow = await guestsWithPaymentDue();
const dueWithEmail = dueNow.filter(({ guest }) => guest.email);
const dueDeposits = dueWithEmail.filter(({ due }) => due.kind === "deposit").length;
const lastEmailed = await lastPaymentDueEmailAt();
const emailedCount = Astro.url.searchParams.get("emailed");
const londonDate = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "Europe/London" });
const counts = {
  unpaid: attending.filter((g) => g.payment_status === "unpaid").length,
  deposit_paid: attending.filter((g) => g.payment_status === "deposit_paid").length,
  paid_full: attending.filter((g) => g.payment_status === "paid_full").length,
};
// Anyone owed money back: overpaid against their current price, or
// cancelled with money still recorded as paid.
const owed = guests
  .map((g) => ({
    guest: g,
    amount: g.status === "cancelled" ? Math.max(0, g.amount_paid_pence ?? 0) : overpaidBy(g, settings),
  }))
  .filter((row) => row.amount > 0);
---

<Layout title="Payments | Over the Hill" description="Ticket price, deposit and payment settings.">
  <main id="main" tabindex="-1" class="admin-main">
    <AdminHeader title="Payments">
      Set the deposit and ticket price, and open payments when you're ready. You can set or change the price after deposits have been taken: balances are always worked out from the current price.
    </AdminHeader>

    <section class="page-content">
      {!stripeConfigured && (
        <article class="content-block notice">
          <h2>Stripe isn't set up on this site yet</h2>
          <p>You can save amounts, but payments can't be opened until the Stripe keys are added (see docs/deployment.md).</p>
        </article>
      )}
      {error && (
        <article class="content-block notice">
          <h2>Not saved</h2>
          <p>{error}</p>
        </article>
      )}
      {saved === "1" && !error && (
        <article class="content-block notice">
          <p>Saved.</p>
        </article>
      )}

      <form class="rsvp-form" method="POST" action="/admin/payments">
        <div class="form-field">
          <label for="deposit">Deposit (£)</label>
          <input id="deposit" name="deposit" type="text" inputmode="decimal" pattern="£?[0-9]{1,5}(\.[0-9]{1,2})?" value={amountValue(settings.depositPence)} />
        </div>

        <div class="form-field">
          <label for="standardPrice">Ticket price (£)</label>
          <input id="standardPrice" name="standardPrice" type="text" inputmode="decimal" pattern="£?[0-9]{1,5}(\.[0-9]{1,2})?" placeholder="Not decided yet" value={amountValue(settings.standardPricePence)} />
        </div>
        <p class="form-field-help">
          Leave blank until the final price is known. Performers with their own
          price (set on their guest page) use that instead, and pay a deposit
          capped at their price.
        </p>

        <div class="form-field form-field-checkbox">
          <input id="depositsOpen" name="depositsOpen" type="checkbox" checked={settings.depositsOpen} />
          <label for="depositsOpen">Deposits open</label>
        </div>
        <div class="form-field form-field-checkbox">
          <input id="balanceOpen" name="balanceOpen" type="checkbox" checked={settings.balanceOpen} />
          <label for="balanceOpen">Balance payments open</label>
        </div>
        <p class="form-field-help">
          Guests who haven't paid anything see a "Pay deposit" button while
          deposits are open. Guests who've paid a deposit see "Pay balance"
          once balance payments are open and a price is set. With deposits
          closed and balance payments open, anyone who's paid nothing pays the
          whole price in one go ("Pay for your ticket").
        </p>
        <div class="payment-stages">
          <p><strong>What each stage looks like:</strong></p>
          <ul>
            <li><strong>Nothing to pay yet:</strong> both boxes off. Saying yes puts guests straight on the list.</li>
            <li><strong>Taking deposits:</strong> set the deposit, tick Deposits open. New yeses pay the deposit to get on the list; guests already on the list stay on it and see the deposit is due.</li>
            <li><strong>Taking full payments:</strong> set the ticket price, untick Deposits open, tick Balance payments open. New yeses pay the whole price to get on the list; deposit payers pay the rest; anyone on the list who's paid nothing pays the whole price.</li>
          </ul>
          <p>After opening payments, email the guests already on the list (below), so they know.</p>
        </div>

        <button class="button" type="submit">Save payment settings</button>
      </form>

      <form class="rsvp-form" method="POST" action="/admin/payments" id="tickets">
        <input type="hidden" name="form" value="tickets" />
        <h2>Tickets</h2>
        {saved === "tickets" && <p>Saved.</p>}
        <div class="form-field form-field-checkbox">
          <input id="qrCodes" name="qrCodes" type="checkbox" checked={ticketSettings.qrCodes} />
          <label for="qrCodes">Show QR codes on tickets</label>
        </div>
        <p class="form-field-help">
          Leave this off until door check-in scanning exists: the codes point to
          a check-in page that isn't built yet. While it's off, registered
          guests see their ticket reference instead.
        </p>
        <button class="button" type="submit">Save ticket settings</button>
      </form>

      <article class="content-block" id="notify">
        <h2>Tell guests a payment is due</h2>
        {emailedCount !== null && <p>Sent {emailedCount} {emailedCount === "1" ? "email" : "emails"}.</p>}
        {emailError && <p><strong>Not all sent:</strong> {emailError}</p>}
        {dueNow.length === 0 ? (
          <p>Nobody coming has anything to pay right now{settings.depositsOpen || settings.balanceOpen ? "" : " (payments are closed)"}.</p>
        ) : (
          <>
            <p>
              {dueNow.length} {dueNow.length === 1 ? "guest" : "guests"} coming can pay something right now
              {dueDeposits > 0 && dueDeposits < dueWithEmail.length
                ? ` (${dueDeposits} a deposit, ${dueWithEmail.length - dueDeposits} their ticket or balance)`
                : dueDeposits > 0 ? " (a deposit)" : " (their ticket or balance)"}.
              {dueWithEmail.length < dueNow.length && ` ${dueNow.length - dueWithEmail.length} of them have no email address, so you'll need to tell them yourself.`}
            </p>
            <p>
              Each gets an email saying what's due and how much, with a link to
              their page to pay. It goes to everyone who owes something now, so
              anyone emailed before gets it again.
              {lastEmailed && ` Last sent ${londonDate(lastEmailed)}.`}
            </p>
            {dueWithEmail.length > 0 && (
              <form
                method="POST"
                action="/admin/payments"
                data-confirm={`Email ${dueWithEmail.length} ${dueWithEmail.length === 1 ? "guest" : "guests"} that a payment is due?`}
              >
                <input type="hidden" name="form" value="notify" />
                <button class="button" type="submit">
                  Email {dueWithEmail.length} {dueWithEmail.length === 1 ? "guest" : "guests"}
                </button>
              </form>
            )}
          </>
        )}
      </article>

      <article class="content-block">
        <h2>Totals</h2>
        <ul class="information-list">
          <li>Received: {formatPence(received)}</li>
          <li>Still to collect: {formatPence(toCollect)}{unpriced > 0 && ` (plus ${unpriced} ${unpriced === 1 ? "guest" : "guests"} with no price set yet)`}</li>
          <li>Attending: {attending.length} ({counts.paid_full} paid in full, {counts.deposit_paid} deposit paid, {counts.unpaid} not paid)</li>
          {awaitingPayment > 0 && <li>Said yes but haven't paid yet (not on the list until they do): {awaitingPayment}</li>}
        </ul>
      </article>

      {owed.length > 0 && (
        <article class="content-block">
          <h2>Refunds to make</h2>
          <p>Refund these in the Stripe Dashboard first, then record the refund on the guest's page.</p>
          <ul class="information-list">
            {owed.map(({ guest, amount }) => (
              <li>
                <a class="text-link" href={`/admin/guests/${guest.id}/edit`}>{guest.name}</a>:{" "}
                {formatPence(amount)} {guest.status === "cancelled" ? "(cancelled)" : "(paid over their price)"}
              </li>
            ))}
          </ul>
        </article>
      )}
    </section>
  </main>
</Layout>
