---
import Layout from "../../../../layouts/Layout.astro";
import PerformerFields from "../../../../components/PerformerFields.astro";
import { getGuestById, listPaymentsForGuest } from "../../../../lib/guests";
import { getPaymentSettings } from "../../../../lib/settings";
import { overpaidBy, ticketPrice } from "../../../../lib/payments";
import { formatPence } from "../../../../lib/money";

const { id } = Astro.params;
const guest = id ? await getGuestById(id) : null;
const payments = guest ? await listPaymentsForGuest(guest.id) : [];
const settings = await getPaymentSettings();
const price = guest ? ticketPrice(guest, settings) : null;
const paid = guest?.amount_paid_pence ?? 0;
const cancelled = guest?.status === "cancelled";
const overpaid = guest ? overpaidBy(guest, settings) : 0;

const PAYMENT_MESSAGES: Record<string, string> = {
  recorded: "Recorded.",
  invalid_amount: "Enter an amount in pounds, like 20 or 12.50.",
  refund_too_big: "That's more than they've paid, so it wasn't recorded.",
};
const paymentMessage = PAYMENT_MESSAGES[Astro.url.searchParams.get("payment") ?? ""];
const KIND_LABELS = { deposit: "Deposit (card)", balance: "Balance (card)", manual: "Manual payment", refund: "Refund" };
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Layout title="Edit guest | Over the Hill" description="Edit a guest's details.">
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <p class="eyebrow">Hosts only</p>
        <h1>{guest ? `Edit ${guest.name}` : "Guest not found"}</h1>
      </div>
    </section>

    <section class="page-content">
      {!guest && (
        <article class="content-block">
          <p>We couldn't find that guest.</p>
          <a class="text-link" href="/admin">← Back to guest list</a>
        </article>
      )}

      {guest && (
        <>
          <form class="rsvp-form" method="POST" action={`/api/admin/guests/${guest.id}`}>
            <div class="form-field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" value={guest.name} required />
            </div>

            <div class="form-field">
              <label for="inviterNames">Invited by</label>
              <input
                id="inviterNames"
                name="inviterNames"
                type="text"
                value={guest.inviters.join(", ")}
                placeholder="Separate multiple names with commas"
              />
            </div>

            <div class="form-field">
              <label for="email">Email address</label>
              <input id="email" name="email" type="email" value={guest.email ?? ""} />
            </div>

            <div class="form-field">
              <label for="phone">Phone number</label>
              <input id="phone" name="phone" type="tel" value={guest.phone ?? ""} />
            </div>

            <PerformerFields
              isPerformer={guest.is_performer === 1}
              amountDuePence={guest.amount_due_pence}
            />

            <div class="form-field">
              <label for="attendance">Attendance</label>
              <select id="attendance" name="attendance">
                <option value="pending" selected={guest.attendance === "pending"}>Pending</option>
                <option value="yes" selected={guest.attendance === "yes"}>Attending</option>
                <option value="no" selected={guest.attendance === "no"}>Regretfully declining</option>
              </select>
            </div>

            <div class="form-field">
              <label for="arrivalDay">Arrival day</label>
              <input id="arrivalDay" name="arrivalDay" type="text" value={guest.arrival_day ?? ""} />
            </div>

            <div class="form-field">
              <label for="departureDay">Departure day</label>
              <input id="departureDay" name="departureDay" type="text" value={guest.departure_day ?? ""} />
            </div>

            <div class="form-field">
              <label for="camping">Camping arrangements</label>
              <select id="camping" name="camping">
                <option value="" selected={!guest.camping}>Not set</option>
                <option value="camping" selected={guest.camping === "camping"}>Camping</option>
                <option value="not_camping" selected={guest.camping === "not_camping"}>Not camping</option>
                <option value="undecided" selected={guest.camping === "undecided"}>Undecided</option>
              </select>
            </div>

            <div class="form-field">
              <label for="vehicle">Vehicle</label>
              <select id="vehicle" name="vehicle">
                <option value="" selected={!guest.vehicle}>Not set</option>
                <option value="none" selected={guest.vehicle === "none"}>Nope</option>
                <option value="campervan" selected={guest.vehicle === "campervan"}>Bringing a campervan</option>
                <option value="car" selected={guest.vehicle === "car"}>Bringing a car</option>
                <option value="undecided" selected={guest.vehicle === "undecided"}>Undecided</option>
              </select>
            </div>

            <div class="form-field">
              <label for="dietary">Dietary requirements or allergies</label>
              <textarea id="dietary" name="dietary" rows="4">{guest.dietary ?? ""}</textarea>
            </div>

            <div class="form-field">
              <label for="accessibility">Accessibility requirements</label>
              <textarea id="accessibility" name="accessibility" rows="4">{guest.accessibility ?? ""}</textarea>
            </div>

            <div class="form-field">
              <label for="notes">Notes</label>
              <textarea id="notes" name="notes" rows="4">{guest.notes ?? ""}</textarea>
            </div>

            <button class="button" type="submit">Save changes</button>
          </form>

          <section id="payments" class="content-block admin-payments">
            <h2>Payments</h2>
            {paymentMessage && <p class="notice">{paymentMessage}</p>}
            <ul class="information-list">
              <li>Ticket price: {price === null ? "not set yet" : formatPence(price)}</li>
              <li>Paid: {formatPence(paid)}{price !== null && paid < price && `, ${formatPence(price - paid)} left`}</li>
              {cancelled && <li><strong>Place cancelled</strong>{paid > 0 && `: ${formatPence(paid)} still recorded as paid (refund it in Stripe, then record the refund)`}</li>}
              {!cancelled && overpaid > 0 && <li><strong>Overpaid by {formatPence(overpaid)}</strong>: refund it in Stripe, then record the refund below.</li>}
            </ul>

            {payments.length > 0 && (
              <div class="admin-table-wrapper">
                <table class="admin-table">
                  <thead>
                    <tr><th>Date</th><th>Type</th><th>Amount</th><th>Note / reference</th></tr>
                  </thead>
                  <tbody>
                    {payments.map((payment) => (
                      <tr>
                        <td>{formatDate(payment.created_at)}</td>
                        <td>{KIND_LABELS[payment.kind]}</td>
                        <td>{payment.amount_pence < 0 ? `−${formatPence(-payment.amount_pence)}` : formatPence(payment.amount_pence)}</td>
                        <td>{[payment.note, payment.stripe_ref].filter(Boolean).join(" · ") || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <form
              class="rsvp-form admin-payment-form"
              method="POST"
              action={`/api/admin/guests/${guest.id}/payments`}
              onsubmit="return confirm('Record this payment?')"
            >
              <h3>Record a manual payment</h3>
              <input type="hidden" name="action" value="manual" />
              <div class="form-field">
                <label for="manualAmount">Amount (£)</label>
                <input id="manualAmount" name="amount" type="text" inputmode="decimal" pattern="£?[0-9]{1,5}(\.[0-9]{1,2})?" required />
              </div>
              <div class="form-field">
                <label for="manualNote">Note</label>
                <input id="manualNote" name="note" type="text" placeholder="e.g. Cash at the planning meeting" />
              </div>
              <button class="button" type="submit">Record payment</button>
            </form>

            {paid > 0 && (
              <form
                class="rsvp-form admin-payment-form"
                method="POST"
                action={`/api/admin/guests/${guest.id}/payments`}
                onsubmit="return confirm('Have you already made this refund in the Stripe Dashboard?')"
              >
                <h3>Record a refund</h3>
                <p class="form-field-help">Make the refund in the Stripe Dashboard first. This only updates our records.</p>
                <input type="hidden" name="action" value="refund" />
                <div class="form-field">
                  <label for="refundAmount">Amount refunded (£)</label>
                  <input id="refundAmount" name="amount" type="text" inputmode="decimal" pattern="£?[0-9]{1,5}(\.[0-9]{1,2})?" required />
                </div>
                <div class="form-field">
                  <label for="refundRef">Stripe refund ID (optional)</label>
                  <input id="refundRef" name="stripeRef" type="text" placeholder="re_..." />
                </div>
                <div class="form-field">
                  <label for="refundNote">Note</label>
                  <input id="refundNote" name="note" type="text" placeholder="e.g. Can't make it any more" />
                </div>
                <button class="button" type="submit">Record refund</button>
              </form>
            )}

            <form
              method="POST"
              action={`/api/admin/guests/${guest.id}/cancel`}
              onsubmit={cancelled
                ? "return confirm('Reinstate this place? They will be able to pay again.')"
                : "return confirm('Cancel this place? They will no longer be able to pay, and their ticket will show as cancelled.')"}
            >
              <input type="hidden" name="action" value={cancelled ? "reinstate" : "cancel"} />
              <button class="text-link admin-inline-button status-expired" type="submit">
                {cancelled ? "Reinstate place" : "Cancel place"}
              </button>
            </form>
          </section>

          <form
            method="POST"
            action={`/api/admin/guests/${guest.id}/regenerate`}
            onsubmit="return confirm('Regenerate this guest\'s link? Their current link will stop working immediately.')"
          >
            <button class="button" type="submit">Regenerate link</button>
          </form>

          <form
            method="POST"
            action={`/api/admin/guests/${guest.id}/delete`}
            onsubmit={`return confirm(${JSON.stringify(`Delete ${guest.name} and all their RSVP details? This can't be undone.`)})`}
          >
            <button class="text-link admin-inline-button status-expired" type="submit">Delete guest</button>
          </form>

          <div class="page-actions">
            <a class="text-link" href="/admin">← Back to guest list</a>
          </div>
        </>
      )}
    </section>
  </main>
</Layout>
