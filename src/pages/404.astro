        <p class="page-introduction">
          This part of the site isn't ready yet — more is coming soon. In the
          meantime, here's what's live right now.
        </p>
      </div>
    </section>

    <section class="page-content">
      <div class="page-actions">
        <a class="button" href="/">Back to the splash page</a>
        <a class="text-link" href="/rsvp">Go to RSVP →</a>
      </div>
    </section>
  </main>
</Layout>
