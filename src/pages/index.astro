---
import Layout from "../layouts/Layout.astro";
import { getPageContent } from "../lib/content";
import Poster from "../components/Poster.astro";

const { fields } = await getPageContent("index");
const hosts = (fields.credits ?? "")
  .split("\n")
  .map((name) => name.trim())
  .filter(Boolean);
---

<Layout
  title="Over the Hill"
  description="Information about our party, including camping, food, activities and travel."
>
  <main class="homepage-main">

    <section class="poster-hero">
      <h1 class="visually-hidden">
        Over the Hill Festival – August 13th to 15th 2027 at Out to Grass
      </h1>

      <Poster />

      <div class="home-text">
        <p class="hero-description">{fields.tagline}</p>
        <p class="event-details">{fields.venue_line}</p>
        <div class="button-row">
          <a class="button" href="/rsvp">{fields.cta_label}</a>
          <a class="text-link" href="/location">{fields.location_cta_label || "Where is it?"}</a>
        </div>

        <p class="credit-line">Brought to you by {hosts.join(", ")}</p>
      </div>
    </section>
  </main>
</Layout>
