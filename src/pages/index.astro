---
import Layout from "../layouts/Layout.astro";

const hosts = [
  "Beth Adams",
  "Andrew Conaboy",
  "Bryony Lumb Morollon",
  "Kirsty Buchan",
  "Zubin Roy",
  "Alex Ball",
  "Alex Prior Crespo",
  "Cameron Johnston",
  "Emma Goss",
  "James Jackson",
];
---

<Layout
  title="Over the Hill"
  description="Information about our party, including camping, food, activities and travel."
>
  <main class="homepage-main">
    <section class="poster-hero">
      <h1 class="visually-hidden">
        Over the Hill Festival – August 13th to 15th 2027 at Out to Grass
      </h1>

      <div class="poster-hero-art">
        <img
          src="/images/poster-illustration.webp"
          alt="A twisting tree over rolling green hills, a disco-ball sun with orange rays, wild flowers and mushrooms"
          width="720"
          height="983"
        />
        <svg aria-hidden="true" viewBox="0 0 900 980">
          <defs>
            <path id="poster-arc-top" d="M 30 490 A 420 450 0 0 1 870 490" />
            <path id="poster-arc-bottom" d="M 20 490 A 430 460 0 0 0 880 490" />
          </defs>
          <text class="poster-arc-title">
            <textPath href="#poster-arc-top" startOffset="50%" text-anchor="middle">
              OVER THE HILL FESTIVAL
            </textPath>
          </text>
          <text class="poster-arc-date">
            <textPath href="#poster-arc-bottom" startOffset="50%" text-anchor="middle">
              AUGUST 13TH – 15TH 2027 @ OUT TO GRASS
            </textPath>
          </text>
        </svg>
      </div>

      <div class="home-text">
        <p class="hero-description">A weekend of dancing, partying and fannying about</p>
        <p class="event-details">Out to Grass, Woodend Farm, Cradley, WR13 5JW</p>
        <div class="button-row">
          <a class="button" href="/rsvp">RSVP now</a>
        </div>

        <p class="credit-line">Brought to you by {hosts.join(", ")}</p>
      </div>
    </section>
  </main>
</Layout>
