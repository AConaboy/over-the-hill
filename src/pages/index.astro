---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Over the Hill"
  description="Information about our party, including camping, food, activities and travel."
>
  <main class="homepage-main">
    <section class="simple-homepage">
      <div class="home-text">
        <h1>Over the Hill</h1>
        <p class="event-details">
          August 13–15, 2027<br />
          Woodend Farm, Cradley<br />
          WR13 5JW
        </p>
        <p class="hero-description">
          A weekend of dancing, partying and fannying about
        </p>
      </div>

      <div class="art-panel">
        <img
          src="/images/over-the-hill-artwork-1.jpeg"
          alt="Over the Hill artwork"
        />
      </div>
    </section>
  </main>
</Layout>
