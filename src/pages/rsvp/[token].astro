---
import Layout from "../../layouts/Layout.astro";
import LinkProblemNotice from "../../components/LinkProblemNotice.astro";
import TicketQr from "../../components/TicketQr.astro";
import { getGuestByToken, isLinkExpired, markViewed } from "../../lib/guests";

const { token } = Astro.params;
const guest = token ? await getGuestByToken(token) : null;

const expired = guest ? isLinkExpired(guest) : false;

if (guest && !expired) {
  await markViewed(guest);
}

const submitted = Astro.url.searchParams.get("submitted") === "1";
---

<Layout
  title="RSVP | Over the Hill"
  description="RSVP for Over the Hill and provide camping, dietary and activity information."
>
  <main>
    {!guest && <LinkProblemNotice kind="not_found" />}
    {guest && expired && <LinkProblemNotice kind="expired" />}

    {guest && !expired && (
      <>
        <section class="page-hero">
          <div class="page-hero-content">
            <p class="eyebrow">Be there or be square 🟦</p>
            <h1>RSVP</h1>
            <p class="page-introduction">
              Please complete the form so that we know who is coming,
              who is camping and whether you have any dietary or
              accessibility requirements.
            </p>
          </div>
        </section>

        <section class="page-content">
          {submitted && (
            <article class="content-block notice">
              <p class="eyebrow">Thanks, {guest.name}!</p>
              <h2>
                {guest.attendance === "yes" ? "See you there!" : "Sorry to miss you"}
              </h2>
              <p>
                {guest.attendance === "yes"
                  ? "We've got your answers. A confirmation email is on its way to you too."
                  : "Thanks for letting us know — we'll miss you."}
              </p>

              {guest.attendance === "yes" && guest.ticket_ref && (
                <TicketQr ticketRef={guest.ticket_ref} />
              )}

              <p>
                <a class="text-link" href={`/ticket/${guest.token}`}>
                  View your ticket any time →
                </a>
              </p>
            </article>
          )}

          <article class="content-block rsvp-introduction">
            <h2>Please RSVP by 1 May 2027</h2>

            <p>
              We're collecting attendance, camping arrangements,
              dietary requirements and accessibility needs so we can plan
              the weekend properly.
            </p>

            <p>
              A wee statement on the data collection is at the end for the very privacy-conscious 🙂
            </p>
          </article>

          <form class="rsvp-form" method="POST" action="/api/rsvp">
            <input type="hidden" name="token" value={guest.token} />

            <div class="form-field">
              <label for="name">Name</label>
              <input id="name" type="text" value={guest.name} disabled />
            </div>

            <div class="form-field">
              <label for="email">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                value={guest.email ?? ""}
                required
              />
            </div>

            <div class="form-field">
              <label for="phone">Phone number</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                value={guest.phone ?? ""}
              />
            </div>

            <div class="form-field">
              <label for="attendance">Attendance</label>
              <select id="attendance" name="attendance" required>
                <option value="" selected={guest.attendance === "pending"}>Please select</option>
                <option value="yes" selected={guest.attendance === "yes"}>Attending</option>
                <option value="no" selected={guest.attendance === "no"}>Regretfully declining</option>
              </select>
            </div>

            <div class="form-field">
              <label for="arrivalDay">Arrival day</label>
              <input
                id="arrivalDay"
                name="arrivalDay"
                type="text"
                placeholder="e.g. Friday"
                value={guest.arrival_day ?? ""}
              />
            </div>

            <div class="form-field">
              <label for="departureDay">Departure day</label>
              <input
                id="departureDay"
                name="departureDay"
                type="text"
                placeholder="e.g. Sunday"
                value={guest.departure_day ?? ""}
              />
            </div>

            <div class="form-field">
              <label for="camping">Camping arrangements</label>
              <select id="camping" name="camping">
                <option value="" selected={!guest.camping}>Please select</option>
                <option value="camping" selected={guest.camping === "camping"}>Camping</option>
                <option value="not_camping" selected={guest.camping === "not_camping"}>Not camping</option>
                <option value="undecided" selected={guest.camping === "undecided"}>Undecided</option>
              </select>
            </div>

            <div class="form-field">
              <label for="vehicle">Are you bringing a vehicle?</label>
              <select id="vehicle" name="vehicle">
                <option value="" selected={!guest.vehicle}>Please select</option>
                <option value="none" selected={guest.vehicle === "none"}>Nope</option>
                <option value="campervan" selected={guest.vehicle === "campervan"}>Bringing a campervan</option>
                <option value="car" selected={guest.vehicle === "car"}>Bringing a car</option>
                <option value="undecided" selected={guest.vehicle === "undecided"}>Undecided</option>
              </select>
            </div>

            <div class="form-field">
              <label for="dietary">Dietary requirements or allergies</label>
              <textarea
                id="dietary"
                name="dietary"
                rows="4"
                placeholder="Let us know about allergies, dietary needs, or food preferences"
              >{guest.dietary ?? ""}</textarea>
            </div>

            <div class="form-field">
              <label for="accessibility">Accessibility requirements</label>
              <textarea
                id="accessibility"
                name="accessibility"
                rows="4"
                placeholder="Let us know if you need any support or adjustments"
              >{guest.accessibility ?? ""}</textarea>
            </div>

            <div class="form-field">
              <label for="notes">Anything else?</label>
              <textarea
                id="notes"
                name="notes"
                rows="4"
                placeholder="Any other information you'd like us to know"
              >{guest.notes ?? ""}</textarea>
            </div>

            <button class="button" type="submit">
              Send RSVP
            </button>
          </form>

          <article class="content-block">
            <h2>Changing your response</h2>

            <p>
              If your plans change after submitting the form, complete
              it again or contact one of the hosts. We'll use your most recent response to plan the event.
            </p>
          </article>

          <article class="content-block">
            <h2>Paying</h2>

            <p>
              No payment is needed at this stage — RSVPs are free. If we introduce
              a deposit or ticket price later, we'll let you know on your
              <a href={`/ticket/${guest.token}`}>ticket page</a>.
            </p>
          </article>

          <article class="content-block">
            <h2>Questions?</h2>

            <p>
              Contact one of the hosts if you are unsure
              about camping, food, travel or anything else before
              submitting your response.
            </p>
          </article>

          <article class="content-block">
            <h2>Data protection notice</h2>

            <p>
              We collect your name, email address, and the information
              you provide about attendance, camping, dietary needs,
              accessibility requirements, and activities so that we can
              plan the event and make appropriate arrangements for you.
            </p>

            <p>
              We will process this information for the purpose of
              organising the event, fulfilling your RSVP, and making
              reasonable adjustments where needed. We will only keep
              it for as long as necessary to manage the event and will
              then delete it unless we are required to retain it for a
              lawful reason.
            </p>

            <p>
              The information may be shared only with the event hosts and
              any service providers necessary to organise the event, such
              as our database and email providers. We will not use your
              data for marketing or any unrelated purpose.
            </p>

            <p>
              You have the right to ask for access to, correction of, or
              deletion of your personal data, and to withdraw your
              consent at any time by contacting Andrew or another host.
              By submitting this form, you confirm that you understand
              how your information will be used and that you consent to
              this processing.
            </p>

            <p>
              The data in this form is stored in Supabase, our database
              provider, and confirmation emails are sent via Resend, our
              email provider.
            </p>
          </article>

          <div class="page-actions">
            <a class="text-link" href="/faq">
              ← Read the FAQs
            </a>

            <a class="button" href="/">
              Return home
            </a>
          </div>
        </section>
      </>
    )}
  </main>
</Layout>
