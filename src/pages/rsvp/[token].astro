---
import Layout from "../../layouts/Layout.astro";
import LinkProblemNotice from "../../components/LinkProblemNotice.astro";
import TicketQr from "../../components/TicketQr.astro";
import Poster from "../../components/Poster.astro";
import PaymentPanel from "../../components/PaymentPanel.astro";
import ContentBlockView from "../../components/ContentBlockView.astro";
import { getGuestByToken, hasNothingToPay, isLinkExpired, linkExpiresAt, markViewed } from "../../lib/guests";
import { REMEMBER_COOKIE_NAME, REMEMBER_COOKIE_OPTIONS, RSVPED_COOKIE_NAME } from "../../lib/rememberCookie";
import { findBlock, getPageContent } from "../../lib/content";
import { getPaymentSettings, getTicketSettings } from "../../lib/settings";
import { isAwaitingPayment, isRegistered, nextPayment, type NextPayment } from "../../lib/payments";
import { isStripeConfigured } from "../../lib/stripe";
import { formatPence } from "../../lib/money";
import { CAMPING_LABELS, DAY_LABELS, GLAMPING_LABELS, LIFT_LABELS, VEHICLE_LABELS, liftSummary } from "../../lib/answerLabels";
import { DAY_VALUES } from "../../lib/guests";
import { INSTAGRAM_HANDLE, INSTAGRAM_URL } from "../../lib/site";
import { isLinkPreviewFetch } from "../../lib/linkPreview";
import { deadlineHeading } from "../../lib/content";

// A guest's one page: their invitation, and once they've replied, where
// they stand (registered, deposit to pay, declined), paying, and their
// answers with an Edit button. (It used to be split with /ticket/<token>,
// which now redirects here.)

const { token } = Astro.params;
const guest = token ? await getGuestByToken(token) : null;
const { fields, blocks } = await getPageContent("rsvp-form");
const deadlineContent = findBlock(blocks, "rsvp-form-deadline");
const changingBlock = findBlock(blocks, "rsvp-form-changing");
const questionsBlock = findBlock(blocks, "rsvp-form-questions");

const expired = guest ? isLinkExpired(guest) : false;
// "Please RSVP by {date}": the day their own link stops working.
const deadlineBlock = deadlineContent && guest
  ? { ...deadlineContent, heading: deadlineHeading(deadlineContent.heading, linkExpiresAt(guest)) }
  : deadlineContent;
// A host cancelled their place (usually with a refund): no form to resubmit.
const cancelled = guest?.status === "cancelled";
// Replied (yes or no): they see what they told us, and an Edit button,
// rather than being asked to RSVP again.
const replied = !!guest && guest.attendance !== "pending";

// A chat app fetching the link to build its preview (when a host sends the
// invite) isn't the guest opening it: don't mark it viewed or set cookies.
const previewFetch = isLinkPreviewFetch(Astro.request);

if (guest && !expired && !previewFetch) {
  await markViewed(guest);
  // A valid, live link is the strongest signal we ever get that this
  // browser belongs to this guest — remember them so /rsvp can skip
  // straight to their page next time, without needing their link again.
  Astro.cookies.set(REMEMBER_COOKIE_NAME, guest.token, REMEMBER_COOKIE_OPTIONS);
  if (replied && !cancelled) Astro.cookies.set(RSVPED_COOKIE_NAME, "1", REMEMBER_COOKIE_OPTIONS);
  else Astro.cookies.delete(RSVPED_COOKIE_NAME, { path: "/" });
}

const params = Astro.url.searchParams;
const submitted = params.get("submitted") === "1";
// A change to an earlier reply, rather than the first one.
const updated = params.get("updated") === "1";
// Only set when a confirmation email actually went out. Repeat submissions
// inside the email cooldown still save, but don't send another email.
const emailed = params.get("emailed") === "1";
const payError = params.get("payerror") === "1";
// The form is shown before they've replied, or when they press Edit.
const editing = !replied || params.get("edit") === "1";

// Attending but not paid yet (the deposit, or the whole price without one):
// their answers are saved, but registration (their place, their ticket)
// only completes once it's paid.
const awaitingPayment = guest ? isAwaitingPayment(guest) : false;
const registered = guest ? isRegistered(guest) : false;
const paymentSettings = await getPaymentSettings();
const deposit = guest && (awaitingPayment || registered) ? nextPayment(guest, paymentSettings, isStripeConfigured()) : null;
// What saying yes would mean right now, for the Paying text above the form
// and the note by its button: nothing yet, the deposit, or the whole price.
// Someone already on the list pays nothing more by resubmitting.
const payOnYes: NextPayment = !guest || registered
  ? { kind: "none", reason: "not_attending" }
  : nextPayment({ ...guest, attendance: "yes", ticket_ref: guest.ticket_ref ?? "pending" }, paymentSettings, isStripeConfigured());
const payOnYesLabel = payOnYes.kind === "deposit"
  ? `your ${formatPence(payOnYes.amountPence)} deposit`
  : payOnYes.kind === "balance" ? `for your ticket (${formatPence(payOnYes.amountPence)})` : "";
// Registered before deposits opened (so on the list without paying), and
// the deposit is now due: say so on their "on the list" card, not just in
// the Paying card further down.
const depositNowDue = registered && deposit?.kind === "deposit";
const { qrCodes } = await getTicketSettings();
// Back from Stripe. The webhook, not this redirect, records the payment,
// and clears the guest's open checkout when it does, so an open one means
// it's still on its way.
const paymentPending = params.get("paid") === "1" && Boolean(guest?.checkout_session_id);
// Back from paying, and it's recorded: the butterfly and flowers celebrate
// (keyed by the total paid, so each payment gets one; see butterfly.js).
const celebrate = params.get("paid") === "1" && !paymentPending && (guest?.amount_paid_pence ?? 0) > 0
  ? `paid-${guest?.amount_paid_pence}`
  : undefined;

// The line arcing above the poster's title: "Sam, you are invited to", or
// once they've said yes, "Sam, see you at". Editable in admin: {first_name}
// is the first word of the guest's name as the hosts entered it, {name}
// the whole of it.
const firstName = guest?.name.trim().split(/\s+/)[0] ?? "";
const attending = !!guest && guest.attendance === "yes" && !cancelled;
const lineTemplate = attending
  ? fields.attending_line?.trim() || "{first_name}, see you at"
  : fields.invite_line?.trim() || "{first_name}, you are invited to";
const inviteLine = guest ? lineTemplate.replaceAll("{first_name}", firstName).replaceAll("{name}", guest.name) : "";
const introduction = replied
  ? fields.responded_introduction?.trim() || "Thanks for replying. Your answers are below, and you can change them any time."
  : fields.hero_introduction;

// Their answers, as they'd read them (the form's own wording).
const answers: [string, string | null][] = guest
  ? [
      ["Attendance", guest.attendance === "yes" ? "Attending" : guest.attendance === "no" ? "Regretfully declining" : null],
      ["Email address", guest.email],
      ["Phone number", guest.phone],
      ["Arrival day", guest.arrival_day ? DAY_LABELS[guest.arrival_day] ?? guest.arrival_day : null],
      ["Departure day", guest.departure_day ? DAY_LABELS[guest.departure_day] ?? guest.departure_day : null],
      ["Camping arrangements", guest.camping ? CAMPING_LABELS[guest.camping] ?? guest.camping : null],
      ["Bringing a vehicle", guest.vehicle ? VEHICLE_LABELS[guest.vehicle] ?? guest.vehicle : null],
      ["Lift share", liftSummary(guest)],
      ["Glamping pod", guest.glamping ? `${GLAMPING_LABELS[guest.glamping] ?? guest.glamping} (interest only, not a booking)` : null],
      ["Dietary requirements or allergies", guest.dietary],
      ["Accessibility requirements", guest.accessibility],
      ["Anything else", guest.notes],
    ]
  : [];
const pageUrl = guest ? `/rsvp/${guest.token}` : "";
// "Brought to you by …", the hosts: only for a guest on their own link.
const hosts = (fields.credits ?? "")
  .split("\n")
  .map((name) => name.trim())
  .filter(Boolean);
// Jess's flowers as the bullets of their answers, a different one each line.
const BULLET_FLOWERS = ["flower-02", "flower-05", "flower-01", "flower-04", "flower-06", "flower-03", "flower-07"];
---

<Layout
  title="RSVP | Over the Hill"
  description="RSVP for Over the Hill and provide camping, dietary and activity information."
  shareTitle={guest && !expired && !cancelled ? `${firstName}, you're invited to Over the Hill` : "Over the Hill"}
  shareDescription="13–15 August 2027 at Out to Grass, Cradley. Open your invite to RSVP."
>
  <main id="main" tabindex="-1" class={guest && !expired && !cancelled ? "invite-main" : undefined}>
    {!guest && <LinkProblemNotice kind="not_found" />}
    {guest && expired && <LinkProblemNotice kind="expired" />}
    {guest && !expired && cancelled && <LinkProblemNotice kind="cancelled" />}

    {guest && !expired && !cancelled && (
      <>
        {/* The poster, animated, as the first thing an invited guest sees,
            with their invitation arcing above its title. */}
        <section class="invite-hero">
          <div class="poster-hero">
            <h1 class="visually-hidden">{inviteLine} Over the Hill Festival, August 13th to 15th 2027 at Out to Grass</h1>
            <Poster inviteLine={inviteLine} />
            {/* Down to what to read before replying (the deadline and
                paying, then the form; pulsing after a few seconds), or
                once they've replied, to where they stand. */}
            {replied ? (
              <a class="button invite-jump invite-jump-quiet" href="#rsvp-status">Your RSVP ↓</a>
            ) : (
              <a class="button invite-jump" href={deadlineBlock || !hasNothingToPay(guest) ? "#before-you-reply" : "#rsvp-form"}>RSVP now ↓</a>
            )}
            <div class="invite-text">
              {fields.hero_eyebrow && <p class="eyebrow">{fields.hero_eyebrow}</p>}
              {introduction && <p class="page-introduction">{introduction}</p>}
              {hosts.length > 0 && <p class="credit-line">Brought to you by {hosts.join(", ")}</p>}
            </div>
          </div>
        </section>

        <div class="invite-body">
          {/* id: after sending the form (or paying), the page opens here, at
              where they stand, rather than at the poster. */}
          <section class="page-content" id="rsvp-status" data-celebrate={celebrate}>
            {paymentPending && (
              <article class="content-block notice">
                <h2>Thanks for your payment!</h2>
                <p>
                  It's being confirmed. Refresh this page in a moment
                  {registered ? " if it isn't showing yet." : " to see your place confirmed."}
                </p>
              </article>
            )}

            {payError && (
              <article class="content-block notice">
                <h2>We couldn't start the payment</h2>
                <p>Nothing has been charged. Please try again, or contact a host if it keeps happening.</p>
              </article>
            )}

            {awaitingPayment && !paymentPending && (
              <article class="content-block notice">
                <p class="eyebrow">Almost there{submitted && `, ${firstName}`}!</p>
                <h2>{deposit?.kind === "balance" ? "Pay for your ticket" : "Pay your deposit"} to complete your registration</h2>
                <p>
                  We've saved your answers, but your place isn't confirmed until
                  {deposit?.kind === "balance" ? " your ticket is paid for." : " your deposit is paid."}
                  {submitted && emailed && " We've also emailed you a link so you can finish later."}
                </p>
                {deposit?.kind === "deposit" || deposit?.kind === "balance" ? (
                  <form method="POST" action={`/api/pay/${guest.token}`}>
                    <button class="button" type="submit">{deposit.kind === "deposit" ? "Pay deposit" : "Pay for your ticket"} ({formatPence(deposit.amountPence)})</button>
                  </form>
                ) : (
                  <p>Payments aren't open right now. We'll email you when they are.</p>
                )}
              </article>
            )}

            {registered && (
              <article class="content-block notice">
                {submitted && <p class="eyebrow">{updated ? "Updated" : "Thanks"}, {firstName}!</p>}
                <h2>You're on the list 🎉 See you there!</h2>
                <p>
                  {submitted
                    ? emailed
                      ? "We've got your answers. A confirmation email is on its way to you too."
                      : "We've got your answers."
                    : "You're registered for Over the Hill."}
                </p>
                {guest.ticket_ref && (qrCodes
                  ? <TicketQr ticketRef={guest.ticket_ref} />
                  : <p class="ticket-ref">Your reference: <strong>{guest.ticket_ref}</strong></p>)}
                {guest.payment_status === "paid_full" && <p class="paid-badge">Paid in full</p>}
                <p><a class="text-link" href={`/rsvp/${guest.token}/calendar.ics`} download="over-the-hill.ics">Add it to your calendar</a></p>
                {depositNowDue && deposit?.kind === "deposit" && !paymentPending && (
                  <>
                    <p>Your {formatPence(deposit.amountPence)} deposit is now due.</p>
                    <form method="POST" action={`/api/pay/${guest.token}`}>
                      <button class="button" type="submit">Pay deposit ({formatPence(deposit.amountPence)})</button>
                    </form>
                  </>
                )}
              </article>
            )}

            {guest.attendance === "no" && (
              <article class="content-block notice">
                {submitted && <p class="eyebrow">{updated ? "Updated" : "Thanks"}, {firstName}!</p>}
                <h2>You've told us you can't make it</h2>
                <p>
                  Sorry to miss you! If your plans change, you can change your
                  answer any time.
                </p>
              </article>
            )}

            {registered && !hasNothingToPay(guest) && !depositNowDue && (
              <PaymentPanel
                guest={guest}
                settings={paymentSettings}
                stripeConfigured={isStripeConfigured()}
                paymentPending={paymentPending}
              />
            )}

            {/* Once they've replied: where to hear what's happening next. */}
            {replied && !editing && (
              <article class="content-block follow-us">
                <h2>Follow us for updates</h2>
                <p>
                  Line-up news, plans and reminders go up on Instagram first,
                  at <strong>@{INSTAGRAM_HANDLE}</strong>.
                </p>
                <p>
                  <a class="button" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
                    <svg class="follow-us-icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
                      <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
                      <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
                      <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
                    </svg>
                    Follow us<span class="visually-hidden"> on Instagram (opens in a new tab)</span>
                  </a>
                </p>
              </article>
            )}

            {replied && !editing && (
              <article class="content-block">
                <h2>Your answers</h2>
                <ul class="flower-list">
                  {answers.filter(([, value]) => value).map(([label, value], i) => (
                    <li>
                      <img src={`/images/flowers/${BULLET_FLOWERS[i % BULLET_FLOWERS.length]}.webp`} alt="" width="26" height="30" />
                      <span><strong>{label}:</strong> {value}</span>
                    </li>
                  ))}
                </ul>
                <p>
                  <a class="button" href={`${pageUrl}?edit=1#rsvp-form`}>Edit your response</a>
                </p>
              </article>
            )}

            {/* "RSVP now" lands here: the first thing above the form. */}
            {!replied && deadlineBlock && <ContentBlockView block={deadlineBlock} id="before-you-reply" />}
            {/* Before they've replied: what paying involves right now, read
                before the form. After, the Paying card above says exactly
                what's due. Free performers have nothing to pay either way. */}
            {!replied && !hasNothingToPay(guest) && (
              <article class="content-block" id={deadlineBlock ? undefined : "before-you-reply"}>
                <h2>Paying</h2>
                {payOnYes.kind === "deposit" ? (
                  <p>
                    A {formatPence(payOnYes.amountPence)} deposit secures your place.
                    If you're coming, you'll go straight on to pay it by card
                    after sending this form (payments are handled securely by
                    Stripe). The rest is due once the final ticket price is
                    confirmed.
                  </p>
                ) : payOnYes.kind === "balance" ? (
                  <p>
                    Tickets are {formatPence(payOnYes.amountPence)}. If you're
                    coming, you'll go straight on to pay by card after sending
                    this form (payments are handled securely by Stripe), and
                    your place is confirmed once it's paid.
                  </p>
                ) : (
                  <p>
                    There's nothing to pay yet: say you're coming and you're on
                    the list. When payments open we'll email you, and a button
                    to pay will appear on this page.
                  </p>
                )}
              </article>
            )}

            {editing && (
              <form class="rsvp-form" id="rsvp-form" method="POST" action="/api/rsvp">
                {replied && <h2>Edit your response</h2>}
                <input type="hidden" name="token" value={guest.token} />

                <div class="form-field">
                  <label for="name">Name</label>
                  <input id="name" type="text" value={guest.name} disabled />
                </div>

                <div class="form-field">
                  <label for="email">Email address <span class="field-required">(required)</span></label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    value={guest.email ?? ""}
                    required
                  />
                </div>

                <div class="form-field">
                  <label for="phone">Phone number</label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    value={guest.phone ?? ""}
                  />
                </div>

                <div class="form-field">
                  <label for="attendance">Attendance <span class="field-required">(required)</span></label>
                  <select id="attendance" name="attendance" required>
                    <option value="" selected={guest.attendance === "pending"}>Please select</option>
                    <option value="yes" selected={guest.attendance === "yes"}>Attending</option>
                    <option value="no" selected={guest.attendance === "no"}>Regretfully declining</option>
                  </select>
                </div>

                <div class="form-field">
                  <label for="arrivalDay">Arrival day</label>
                  <select id="arrivalDay" name="arrivalDay">
                    <option value="" selected={!guest.arrival_day}>Please select</option>
                    {DAY_VALUES.map((day) => <option value={day} selected={guest.arrival_day === day}>{DAY_LABELS[day]}</option>)}
                  </select>
                </div>

                <div class="form-field">
                  <label for="departureDay">Departure day</label>
                  <select id="departureDay" name="departureDay">
                    <option value="" selected={!guest.departure_day}>Please select</option>
                    {DAY_VALUES.map((day) => <option value={day} selected={guest.departure_day === day}>{DAY_LABELS[day]}</option>)}
                  </select>
                </div>

                <div class="form-field">
                  <label for="camping">Camping arrangements</label>
                  <select id="camping" name="camping">
                    <option value="" selected={!guest.camping}>Please select</option>
                    <option value="camping" selected={guest.camping === "camping"}>Camping</option>
                    <option value="not_camping" selected={guest.camping === "not_camping"}>Not camping</option>
                    <option value="undecided" selected={guest.camping === "undecided"}>Undecided</option>
                  </select>
                </div>

                <div class="form-field">
                  <label for="vehicle">Are you bringing a vehicle?</label>
                  <select id="vehicle" name="vehicle">
                    <option value="" selected={!guest.vehicle}>Please select</option>
                    <option value="none" selected={guest.vehicle === "none"}>Nope</option>
                    <option value="campervan" selected={guest.vehicle === "campervan"}>Bringing a campervan</option>
                    <option value="car" selected={guest.vehicle === "car"}>Bringing a car</option>
                    <option value="undecided" selected={guest.vehicle === "undecided"}>Undecided</option>
                  </select>
                </div>

                {/* Interest only: a few pods, no price yet, nothing reserved. */}
                <div class="form-field">
                  <label for="glamping">Glamping pod (optional)</label>
                  <p class="form-field-note" id="glamping-note">
                    We only have a few glamping pods and don't know the price
                    yet. This is just to see who'd be interested: it doesn't
                    reserve or guarantee you a pod. We'll be in touch.
                  </p>
                  <select id="glamping" name="glamping" aria-describedby="glamping-note">
                    <option value="" selected={!guest.glamping}>No thanks</option>
                    <option value="interested" selected={guest.glamping === "interested"}>I'd be interested</option>
                    <option value="maybe" selected={guest.glamping === "maybe"}>Maybe</option>
                  </select>
                </div>

                {/* Lift share: the hosts put people in touch; guests never
                    see each other's details. "From where?" shows once a
                    lift is chosen, and "Spare seats" when offering one. */}
                <div class="lift-fields">
                  <div class="form-field">
                    <label for="lift">Lift share (optional)</label>
                    <select id="lift" name="lift">
                      <option value="" selected={!guest.lift}>No thanks</option>
                      <option value="offer" selected={guest.lift === "offer"}>{LIFT_LABELS.offer}</option>
                      <option value="need" selected={guest.lift === "need"}>{LIFT_LABELS.need}</option>
                    </select>
                  </div>
                  <div class="form-field lift-from">
                    <label for="liftFrom">From where?</label>
                    <input id="liftFrom" name="liftFrom" type="text" placeholder="e.g. Bristol" value={guest.lift_from ?? ""} />
                  </div>
                  <div class="form-field lift-seats">
                    <label for="liftSeats">Spare seats</label>
                    <input id="liftSeats" name="liftSeats" type="number" min="0" max="20" inputmode="numeric" value={guest.lift_seats ?? ""} />
                  </div>
                </div>

                <div class="form-field">
                  <label for="dietary">Dietary requirements or allergies</label>
                  <textarea
                    id="dietary"
                    name="dietary"
                    rows="4"
                    placeholder="Let us know about allergies, dietary needs, or food preferences"
                  >{guest.dietary ?? ""}</textarea>
                </div>

                <div class="form-field">
                  <label for="accessibility">Accessibility requirements</label>
                  <textarea
                    id="accessibility"
                    name="accessibility"
                    rows="4"
                    placeholder="Let us know if you need any support or adjustments"
                  >{guest.accessibility ?? ""}</textarea>
                </div>

                <div class="form-field">
                  <label for="notes">Anything else?</label>
                  <textarea
                    id="notes"
                    name="notes"
                    rows="4"
                    placeholder="Any other information you'd like us to know"
                  >{guest.notes ?? ""}</textarea>
                </div>

                {/* read before pressing Send: what happens next */}
                {payOnYesLabel && (
                  <p class="rsvp-pay-next">If you're coming, sending this takes you straight on to pay {payOnYesLabel}, by card.</p>
                )}
                <div class="rsvp-form-actions">
                  <button class="button" type="submit">{replied ? "Save changes" : "Send RSVP"}</button>
                  {replied && <a class="text-link" href={`${pageUrl}#rsvp-status`}>Cancel</a>}
                </div>
                <p class="rsvp-privacy-link">
                  <a class="text-link" href="/privacy">How we use your information</a>
                </p>
              </form>
            )}

            {/* a break before the general information */}
            <div class="flower-rule" aria-hidden="true">
              <img src="/images/flowers/flower-01.webp" alt="" width="44" height="58" />
              <img src="/images/flowers/flower-06.webp" alt="" width="44" height="45" />
              <img src="/images/flowers/flower-04.webp" alt="" width="44" height="49" />
            </div>

            {changingBlock && <ContentBlockView block={changingBlock} />}
            {questionsBlock && <ContentBlockView block={questionsBlock} />}

            <div class="page-actions">
              <a class="button" href="/">
                Return home
              </a>
              <a class="text-link" href="/location">Where's the festival? →</a>
            </div>

            {/* This browser remembers them (so /rsvp comes straight here);
                on a shared device, let them undo that. */}
            <form class="forget-device" method="POST" action="/api/rsvp/forget">
              <button class="link-button" type="submit">Not {firstName}? Forget this device</button>
            </form>
          </section>
        </div>
      </>
    )}
  </main>
</Layout>
