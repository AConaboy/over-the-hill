---
import Layout from "../../layouts/Layout.astro";
import { getGuestByToken, isLinkExpired } from "../../lib/guests";
import { REMEMBER_COOKIE_NAME } from "../../lib/rememberCookie";

const remembered = Astro.cookies.get(REMEMBER_COOKIE_NAME)?.value;

if (remembered) {
  const guest = await getGuestByToken(remembered);
  if (guest && !isLinkExpired(guest)) {
    return Astro.redirect(`/rsvp/${guest.token}`, 302);
  }
  // Stale cookie (guest not found, or an unanswered link that's since
  // expired) — clear it rather than checking again on every future visit.
  Astro.cookies.delete(REMEMBER_COOKIE_NAME, { path: "/" });
}

const sent = Astro.url.searchParams.get("sent") === "1";
---

<Layout
  title="RSVP | Over the Hill"
  description="RSVP for Over the Hill using your personal invite link."
>
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <p class="eyebrow">Be there or be square 🟦</p>
        <h1>RSVP</h1>

        <p class="page-introduction">
          RSVPs are by personal invite link, sent to you directly by one of the
          hosts (by email or WhatsApp) — there's no public form to fill in here.
        </p>
      </div>
    </section>

    <section class="page-content">
      <article class="content-block">
        <h2>Get your link by email</h2>

        {sent ? (
          <p>
            If we've got an invite for that email address, we've sent a link
            to it — check your inbox (and spam folder, just in case).
          </p>
        ) : (
          <>
            <p>
              If you know which email address your invite went to, enter it
              below and we'll send your personal link there.
            </p>

            <form class="rsvp-form" method="POST" action="/api/rsvp/find-link">
              <div class="form-field">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" required />
              </div>

              <button class="button" type="submit">Email me my link</button>
            </form>
          </>
        )}
      </article>

      <article class="content-block">
        <h2>Still can't find it?</h2>

        <p>
          Check the email or WhatsApp message you got when you were invited.
          If you've genuinely lost it, or it's stopped working, contact one of
          the hosts and they can send you a new one.
        </p>
      </article>

      <div class="page-actions">
        <a class="button" href="/">Return home</a>
      </div>
    </section>
  </main>
</Layout>
