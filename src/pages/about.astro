---
import Layout from "../layouts/Layout.astro";
import ContentBlockView from "../components/ContentBlockView.astro";
import { getPageContent } from "../lib/content";

// Who the hosts are and what the weekend is. All of its text is editable in
// admin under "About" (the fallbacks below only show if a field is blank).
// The first section is the invitation, shown as a wide card; the rest are
// the questions, in uneven pairs on wide screens (.about-* in style.css).
// Notices (the "Got an idea?" box) come after them.
const { fields, blocks } = await getPageContent("about");
const [invitation, ...questions] = blocks.filter((block) => block.variant === "block");
const notices = blocks.filter((block) => block.variant === "notice");
---

<Layout
  title="About | Over the Hill"
  description={fields.meta_description || "Why we're throwing our own music festival for our 30th birthdays, and what the weekend at Out to Grass will be like."}
>
  <main id="main" tabindex="-1">
    <section class="page-hero about-hero">
      <div class="about-hero-inner">
        <div class="page-hero-content about-hero-text">
          <p class="eyebrow">{fields.hero_eyebrow}</p>
          <h1>{fields.hero_heading}</h1>
          <p class="page-introduction">{fields.hero_introduction}</p>
        </div>
        <figure class="about-photo">
          <img
            src="/images/outtograsssite.webp"
            alt={fields.photo_alt || "Out to Grass at dusk: a lit-up dome, bell tents and festoon lights on a grassy hillside"}
            width="1080"
            height="810"
          />
        </figure>
      </div>
    </section>

    <section class="page-content about-content">
      {invitation && <ContentBlockView block={invitation} id={invitation.id} />}

      <div class="about-questions">
        {questions.map((block) => <ContentBlockView block={block} id={block.id} />)}
      </div>

      {notices.map((block) => <ContentBlockView block={block} />)}

      <div class="page-actions">
        <a class="button" href="/rsvp">{fields.cta_label || "Complete your RSVP"}</a>
        <a class="text-link" href="/location">{fields.location_cta_label || "Where is it?"}</a>
      </div>
    </section>
  </main>
</Layout>
