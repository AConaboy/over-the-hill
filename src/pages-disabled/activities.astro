---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Activities | Over the Hill" description="Activities information for Over the Hill.">
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="sunburst sunburst-small" aria-hidden="true">
          <img class="spot-art" src="/images/spot-butterfly.webp" alt="" width="360" height="360" />
        </div>

        <p class="eyebrow">Staying overnight</p>
        <h1>Fun activitieess</h1>

        <p class="page-introduction">
          Some fun stuff we will plan
        </p>
      </div>
    </section>

    <section class="page-content">
      <article class="content-block">
        <h2>Spikeball?</h2>

        <p>
          I have a spikeball set. No try-hards
        </p>

        <p>
          Art stuff
        </p>

        <p>
          Yoga?
        </p>

        <p>
          More stuff
        </p>
      </article>

      <div class="page-actions">
        <a class="button" href="/rsvp">Confirm your camping plans</a>
        <a class="text-link" href="/food">Next: Food and drink →</a>
      </div>
    </section>
  </main>
</Layout>
