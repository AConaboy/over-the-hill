---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Camping | Over the Hill" description="Camping information for Our Big Party.">
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="sunburst sunburst-small" aria-hidden="true">
          <img class="spot-art" src="/images/spot-mushrooms.webp" alt="" width="360" height="360" />
        </div>

        <p class="eyebrow">Staying overnight</p>
        <h1>Camping</h1>

        <p class="page-introduction">
          Everything you need to know about camping, facilities and what to
          bring for the weekend.
        </p>
      </div>
    </section>

    <section class="page-content">
      <article class="content-block">
        <h2>When you can arrive</h2>

        <p>
          The campsite will open at 3:00 pm on Friday. Please do not arrive
          earlier unless you have arranged this with one of the hosts.
        </p>

        <p>
          Campers should leave by midday on Sunday.
        </p>
      </article>

      <article class="content-block">
        <h2>What is available</h2>

        <ul class="information-list">
          <li>Space for tents</li>
          <li>Toilets</li>
          <li>Drinking water</li>
          <li>Basic washing facilities</li>
          <li>Limited charging points</li>
        </ul>
      </article>

      <article class="content-block">
        <h2>What to bring</h2>

        <ul class="information-list">
          <li>Your tent</li>
          <li>Sleeping bag and sleeping mat</li>
          <li>Warm and waterproof clothing</li>
          <li>A torch</li>
          <li>Reusable water bottle</li>
          <li>Any medication you may need</li>
        </ul>
      </article>

      <article class="content-block">
        <h2>Campervans and vehicles</h2>

        <p>
          Campervan spaces are limited. Please indicate on the RSVP form if you
          plan to bring one.
        </p>

        <p>
          Cars cannot be parked directly beside tents. Parking information is
          available on the <a href="/travel">Travel page</a>.
        </p>
      </article>

      <div class="page-actions">
        <a class="button" href="/rsvp">Confirm your camping plans</a>
        <a class="text-link" href="/food">Next: Food and drink →</a>
      </div>
    </section>
  </main>
</Layout>
