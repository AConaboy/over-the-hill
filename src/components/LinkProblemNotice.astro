---
export interface Props {
  kind: "not_found" | "expired" | "cancelled";
}

const { kind } = Astro.props;

const copy =
  kind === "cancelled"
    ? {
        eyebrow: "Place cancelled",
        heading: "Your place has been cancelled",
        body: "If you think this is a mistake, please contact one of the hosts.",
      }
    : kind === "expired"
    ? {
        eyebrow: "Link expired",
        heading: "This link has expired",
        body: "Ask one of the hosts for a new one.",
      }
    : {
        eyebrow: "Link not recognised",
        heading: "This link isn't valid",
        body: "Double check you copied the whole link, get it emailed to you from the RSVP page, or ask one of the hosts.",
      };
---

<section class="page-hero">
  <div class="page-hero-content">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="page-introduction">{copy.body}</p>
  </div>
</section>

{kind === "not_found" && (
  <section class="page-content">
    <div class="page-actions">
      <a class="button" href="/rsvp">Email me my link</a>
    </div>
  </section>
)}
