---
// The top of every hosts' page: a compact title (no poster-style hero),
// an optional line of explanation (the default slot), and room for the
// page's main buttons (slot "actions").
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="admin-header">
  <div class="admin-header-inner">
    <div class="admin-header-text">
      <h1>{title}</h1>
      {Astro.slots.has("default") && <p class="admin-intro"><slot /></p>}
    </div>
    {Astro.slots.has("actions") && <div class="admin-header-actions"><slot name="actions" /></div>}
  </div>
</header>
