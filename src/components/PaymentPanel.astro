---
// The "Paying" section of a guest's ticket page. What it offers comes from
// nextPayment() in src/lib/payments.ts — the same rules the pay route
// enforces — so the button shown always matches what can actually be paid.
import type { Guest } from "../lib/guests";
import { nextPayment, ticketPrice, type PaymentSettings } from "../lib/payments";
import { formatPence } from "../lib/money";

export interface Props {
  guest: Guest;
  settings: PaymentSettings;
  stripeConfigured: boolean;
}

const { guest, settings, stripeConfigured } = Astro.props;
const next = nextPayment(guest, settings, stripeConfigured);
const price = ticketPrice(guest, settings);
const paid = guest.amount_paid_pence ?? 0;
const remaining = price === null ? null : Math.max(0, price - paid);
---

<article class="content-block payment-panel">
  <h2>Paying</h2>

  {next.kind === "none" && next.reason === "free" ? (
    <p>Nothing to pay — you're performing, so your ticket's on us.</p>
  ) : (
    <>
      <ul class="information-list">
        <li>
          Ticket price: {price === null ? "to be confirmed" : formatPence(price)}
          {guest.is_performer === 1 && guest.amount_due_pence !== null && " (performer price)"}
        </li>
        {paid > 0 && <li>Paid so far: {formatPence(paid)}</li>}
        {paid > 0 && remaining !== null && remaining > 0 && <li>Left to pay: {formatPence(remaining)}</li>}
      </ul>

      {(next.kind === "deposit" || next.kind === "balance") && (
        <form method="POST" action={`/api/pay/${guest.token}`}>
          <button class="button" type="submit">
            {next.kind === "deposit" ? "Pay deposit" : "Pay balance"} ({formatPence(next.amountPence)})
          </button>
        </form>
      )}

      {next.kind === "deposit" && (
        <p class="form-field-help payment-note">
          The deposit secures your place. You'll pay the rest once the final
          price is confirmed.
        </p>
      )}

      {next.kind === "none" && next.reason === "deposits_closed" && (
        <p>
          No payment is needed yet. When payments open, a button to pay will
          show up here, and this ticket will update to show it's been paid.
        </p>
      )}
      {next.kind === "none" && next.reason === "awaiting_price" && (
        <p>
          Thanks for your deposit. We'll confirm the final ticket price and let
          you know when the balance is due.
        </p>
      )}
      {next.kind === "none" && next.reason === "balance_closed" && (
        <p>We'll let you know when the balance is due.</p>
      )}
      {next.kind === "none" && next.reason === "paid_full" && <p>You're paid in full. Thank you!</p>}
    </>
  )}
</article>
