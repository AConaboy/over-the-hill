---
// The festival poster, animated: Jess Porter's illustration with a spinning
// disco-ball sun, sun rays turning behind the whole page, the arcing title
// and dates (the wandering butterfly comes from the layout, and makes the
// poster its home when there is one). Used on the homepage and at the
// top of each guest's invite (RSVP) page. Put it inside the page's <main>.
// Inline (not a separate file): it places the rays, which would otherwise
// wait off-screen until a deferred script ran, after the first paint.
import sunriseScript from "../../public/js/sunrise.js?raw";
import continuityScript from "../../public/js/continuity.js?raw";

export interface Props {
  /** On an invite, a smaller line arcing above the title, e.g. "Sam, you
   * are invited to". The poster sits a little lower to make room for it. */
  inviteLine?: string;
}

const { inviteLine } = Astro.props;

// The poster's separate pieces, back to front, with their image sizes.
const PIECES: [string, number, number][] = [
  ["tulip-tall", 197, 336], ["tulip-left", 177, 220], ["tulip-right", 198, 256],
  ["grass-front", 688, 363],
  ["flower-01", 154, 202], ["flower-02", 174, 218], ["flower-03", 166, 171], ["flower-04", 155, 172],
  ["flower-05", 190, 202], ["flower-06", 189, 194], ["flower-07", 191, 190],
  ["flower-small-08", 114, 127], ["flower-small-09", 129, 127], ["flower-small-10", 117, 137],
];
---

<!-- Sun rays turning behind the whole page, centred on the disco ball
     by /js/sunrise.js. Decorative; still for reduced motion. -->
<svg class="sunrise-rays" aria-hidden="true">
  <defs>
    <radialGradient id="sunrise-fade" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1">
      <!-- strong round the ball, fading out quickly towards the edges -->
      <stop offset="0" stop-opacity="1" />
      <stop offset="0.12" stop-opacity="0.9" />
      <stop offset="0.3" stop-opacity="0.45" />
      <stop offset="0.5" stop-opacity="0.15" />
      <stop offset="0.7" stop-opacity="0.04" />
      <stop offset="1" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g class="pos" transform="translate(-9999 -9999)">
    <g class="scale">
      <g class="spin">
        <polygon points="0,0 -0.1305,-0.9914 0.1305,-0.9914" />
        <polygon points="0,0 0.3827,-0.9239 0.6088,-0.7934" />
        <polygon points="0,0 0.7934,-0.6088 0.9239,-0.3827" />
        <polygon points="0,0 0.9914,-0.1305 0.9914,0.1305" />
        <polygon points="0,0 0.9239,0.3827 0.7934,0.6088" />
        <polygon points="0,0 0.6088,0.7934 0.3827,0.9239" />
        <polygon points="0,0 0.1305,0.9914 -0.1305,0.9914" />
        <polygon points="0,0 -0.3827,0.9239 -0.6088,0.7934" />
        <polygon points="0,0 -0.7934,0.6088 -0.9239,0.3827" />
        <polygon points="0,0 -0.9914,0.1305 -0.9914,-0.1305" />
        <polygon points="0,0 -0.9239,-0.3827 -0.7934,-0.6088" />
        <polygon points="0,0 -0.6088,-0.7934 -0.3827,-0.9239" />
      </g>
    </g>
  </g>
</svg>

<div class:list={["poster-hero-art", { "has-invite": inviteLine }]}>
  <!-- Jess Porter's illustration with its sky, rays and ball cut out,
       over a spinning disco ball that rises behind the hills. -->
  <div class="poster-illustration">
    <!-- Starts as the still ball (28 KB, the animation's first frame);
         /js/sunrise.js swaps in the spinning one (18 frames at 12 fps,
         375 KB) once the page has loaded, unless motion is reduced. -->
    <img class="poster-ball" src="/images/disco-ball-still.webp" data-still="/images/disco-ball-still.webp" data-spin="/images/disco-ball-12fps.webp" alt="" width="360" height="360" />
    <img
      fetchpriority="high"
      src="/images/poster-illustration-bare.webp"
      srcset="/images/poster-illustration-bare-700.webp 700w, /images/poster-illustration-bare.webp 1099w"
      sizes="(max-width: 932px) 58vw, 520px"
      alt="A twisting tree over rolling green hills, a disco-ball sun rising behind them, wild flowers, tulips and mushrooms"
      width="1099"
      height="1490"
    />
    <!-- Jess's flowers and tulips, cut out of the illustration above so they
         can move (/js/flowers.js); at rest they sit exactly as drawn. The
         tulips' stems run down behind her grass (grass-front). -->
    <div class="poster-pieces" data-poster-pieces aria-hidden="true">
      {PIECES.map(([name, w, h]) => (
        <img class:list={["poster-piece", name, { tulip: name.startsWith("tulip") }]} src={`/images/flowers/${name}.webp`} alt="" width={w} height={h} decoding="async" />
      ))}
    </div>
  </div>
  <svg aria-hidden="true" viewBox="0 25 900 875">
    <defs>
      <path id="poster-arc-top" d="M 60 490 A 390 395 0 0 1 840 490" />
      {inviteLine && <path id="poster-arc-invite" d="M -50 490 A 500 505 0 0 1 950 490" />}
      <path id="poster-arc-bottom" d="M 40 490 A 410 400 0 0 0 860 490" />
    </defs>
    {inviteLine && (
      <text class="poster-arc-invite">
        <textPath href="#poster-arc-invite" startOffset="50%" text-anchor="middle">{inviteLine}</textPath>
      </text>
    )}
    <text class="poster-arc-title">
      <textPath href="#poster-arc-top" startOffset="50%" text-anchor="middle">
        OVER THE HILL
      </textPath>
    </text>
    <text class="poster-arc-date">
      <textPath href="#poster-arc-bottom" startOffset="50%" text-anchor="middle">
        AUGUST 13TH – 15TH 2027 @ OUT TO GRASS
      </textPath>
    </text>
  </svg>
</div>

<!-- Inline (from files, hashed into the Content Security Policy): carry
     on from the last page, then place the rays. -->
<script is:inline set:html={continuityScript}></script>
<script is:inline set:html={sunriseScript}></script>
