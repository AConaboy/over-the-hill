# Copy this file to .env and fill in real values for local development.
# In production these are set as Cloudflare Worker secrets instead — see
# docs/deployment.md. The database (Cloudflare D1) needs no secret at all —
# it's configured as a binding in wrangler.jsonc instead.

# Resend API key (resend.com → API Keys)
RESEND_API_KEY=your-resend-api-key

# SITE_URL is set for local dev in .env.development (committed) and
# defaults to production in astro.config.mjs — no need to set it here.
