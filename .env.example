# Copy this file to .env and fill in real values for local development.
# In production these are set as Cloudflare Worker secrets instead — see
# docs/deployment.md. The database (Cloudflare D1) needs no secret at all —
# it's configured as a binding in wrangler.jsonc instead, see below.

# Resend API key (resend.com → API Keys)
RESEND_API_KEY=your-resend-api-key

# Base URL used to build links in emails and QR codes.
# Use your Cloudflare Worker's preview/production URL once deployed.
SITE_URL=http://localhost:4321
