# Copy this file to .env and fill in real values for local development.
# In production these are set as Cloudflare Pages secrets instead — see
# docs/deployment.md.

# Supabase project settings (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API key (resend.com → API Keys)
RESEND_API_KEY=your-resend-api-key

# Base URL used to build links in emails and QR codes.
# Use your Cloudflare Pages preview/production URL once deployed.
SITE_URL=http://localhost:4321
